rules_version = '2';

// Who can read/write what in Firestore.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner';
    }

    // Each user can create/update only their own profile
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid;
    }

    // Only the facility owner manages categories
    match /categories/{id} {
      allow read: if signedIn();
      allow write: if isOwner();
    }

    // Owner manages equipment. Players may only change "quantity"
    // (it goes down when they submit a rental).
    match /equipment/{id} {
      allow read: if signedIn();
      allow create, delete: if isOwner();
      allow update: if isOwner() ||
        (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity']));
    }

    // Players create their own rentals, the owner marks them returned
    match /rentals/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner();
    }
  }
}
